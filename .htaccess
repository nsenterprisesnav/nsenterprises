# Apache only. If your host uses Nginx, configure equivalent rules in its server configuration.
Options -Indexes

# Serve Unicode source text with the same encoding used by the booking template.
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
AddCharset UTF-8 .html .js .css .json .webmanifest .xml .svg .txt
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and the non-www canonical host.
# Check your hosting panel/proxy configuration before enabling to avoid redirect loops.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.saipranayenterprises\.in$ [NC]
RewriteRule ^ https://saipranayenterprises.in%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
